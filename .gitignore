# Data & Tmp folder
data/*
!data/.gitkeep
tmp/*
!tmp/.gitkeep

# Env file
.env
# HPC images
images/
*.sif
.container/image.local.conf

# Python cache & environments
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# JetBrains user-specific files (the shared project config in .idea/ is tracked)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf
